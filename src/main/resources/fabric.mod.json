{
	"schemaVersion": 1,
	"id": "juiceclient",
	"version": "${version}",
	"name": "Juice Client",
	"description": "Block and Entity ESP that finds likely player bases, with tracers, X-Ray and Free Look, plus quality-of-life tools such as Smart Tool, Auto Totem, Auto Eat and inventory sorting.",
	"authors": [
		"JuiceJavaGamer"
	],
	"license": "CC0-1.0",
	"icon": "assets/juiceclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.juiceclient.JuiceClient"
		],
		"modmenu": [
			"com.juiceclient.JuiceClientModMenu"
		]
	},
	"mixins": [
		"juiceclient.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
