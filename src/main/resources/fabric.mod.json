{
	"schemaVersion": 1,
	"id": "basetracer",
	"version": "${version}",
	"name": "Base Tracer",
	"description": "Finds likely player bases: highlights chunks matching rules you choose, such as light sources or combinations of blocks, and draws tracer lines to them.",
	"authors": [
		"JuiceJavaGamer"
	],
	"license": "CC0-1.0",
	"icon": "assets/basetracer/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.basetracer.BaseTracerClient"
		],
		"modmenu": [
			"com.basetracer.BaseTracerModMenu"
		]
	},
	"mixins": [
		"basetracer.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
